LLM_SERVICE_URL=https://sa-llmproxy.it.itba.edu.ar
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL=gpt-4.1
LLM_MODEL_REASONING=
EMBEDDING_MODEL=text-embedding-3-small

PINECONE_API_KEY=
PINECONE_INDEX_NAME=eliseo
PINECONE_REGION=us-east-1

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eliseo

ELISEO_DB_PATH=data/eliseo.db
ELISEO_TTL_HILO_DIAS=7
PROMPT_VECINO_VERSION=v1
PROMPT_MEDIADOR_VERSION=v1
PROMPT_DOCUMENTAL_VERSION=v1

# agente | retriever (sin LLM). En modo agente, si el proxy falla se usa retriever.
DOCUMENTAL_MODO=agente
# Score mínimo del reranker para contestar sin LLM (ver evaluation/documental/RESULTADOS.md)
DOCUMENTAL_UMBRAL_RERANK=0.25

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ADMIN_ID=
