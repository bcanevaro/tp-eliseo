LLM_SERVICE_URL=https://sa-llmproxy.it.itba.edu.ar
LLM_API_KEY=
LLM_MODEL_FAST=gpt-4.1-mini
LLM_MODEL=gpt-4.1
# Modelo de razonamiento del Mediador (nombre en /v1/models del proxy); vacío = LLM_MODEL
LLM_MODEL_REASONING=
# Solo se pasa si hay modelo de razonamiento (gpt-4.1 lo rechaza)
LLM_REASONING_EFFORT=medium

# Los embeddings los calcula Pinecone (multilingual-e5-large, fijo en eliseo/vectores.py)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=eliseo
PINECONE_REGION=us-east-1

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=eliseo

# Base de la plataforma (change cuentas-administracion). Con ELISEO_DB_URL (Supabase: Connect →
# Session pooler, con la contraseña en lugar de [YOUR-PASSWORD], sin los corchetes) la base y los
# checkpoints van a Postgres; vacía, se usa el SQLite de ELISEO_DB_PATH. Los tests nunca la usan.
ELISEO_DB_URL=
ELISEO_DB_PATH=data/eliseo.db
# Supabase Auth (login del panel) y Storage (originales de los documentos). La service_role da
# acceso total al proyecto: solo en este .env, nunca en el código ni en el navegador.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cuenta de prueba que crea scripts/seed_db.py en la Administración Méndez (ficticia).
ELISEO_DEMO_ADMIN_EMAIL=admin@demo.eliseo.test
ELISEO_DEMO_ADMIN_PASSWORD=eliseo-demo
ELISEO_TTL_HILO_DIAS=7
PROMPT_VECINO_VERSION=v1
PROMPT_MEDIADOR_VERSION=v2
PROMPT_DOCUMENTAL_VERSION=v1
PROMPT_INTAKE_VERSION=v1
PROMPT_GASTOS_VERSION=v1

# agente | retriever (sin LLM). En modo agente, si el proxy falla se usa retriever.
DOCUMENTAL_MODO=agente
# Score mínimo del reranker para contestar sin LLM (ver evaluation/documental/RESULTADOS.md)
DOCUMENTAL_UMBRAL_RERANK=0.25

# Un solo bot para todas las administraciones. Cada administración vincula su chat de avisos desde
# el panel (Chat de avisos → /admin <código>); TELEGRAM_CHAT_ADMIN_ID ya no se usa.
TELEGRAM_BOT_TOKEN=

# Intake: llm | reglas (sin LLM). Gastos: agente | codigo (sin LLM). Si el proxy falla, caen solos al modo sin LLM.
INTAKE_MODO=llm
GASTOS_MODO=agente

# Mediador: agente | codigo (sin LLM). Si el proxy falla o el formato sale inválido dos veces, cae a codigo.
MEDIADOR_MODO=agente
# Score mínimo del reranker para usar un precedente. Calibrado en evaluation/mediador/RESULTADOS.md:
# los irrelevantes dan <= 0,001 y PREC-2201 (montante) da 0,004-0,05; con 0,1 se perdía en 4 de 5 consultas
PRECEDENTES_UMBRAL_RERANK=0.002

# 1 habilita /demo 4°B en el bot: vincula tu Telegram con un vecino ficticio de esa unidad
ELISEO_DEMO=1
